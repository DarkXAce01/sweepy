<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Google Play billing (the tip jar) pulls in Google's logging library, which asks for internet
        access to send billing logs. Sweepy promises no internet, so take it back out. Payments still
        work: they go through the Play Store app over an on-device connection, not through Sweepy.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
</manifest>
