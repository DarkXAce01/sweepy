<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Sweepy</string>

    <!-- Permission screen -->
    <string name="permission_title">Let\'s clean up your gallery</string>
    <string name="permission_body">Sweepy needs access to your photos and videos so you can swipe through them.\n\nSweepy has no internet access. Your photos never leave your phone.</string>
    <string name="permission_grant">Allow access</string>
    <string name="permission_denied">Sweepy can\'t work without access to your photos. You can allow it in Settings.</string>
    <string name="permission_open_settings">Open settings</string>

    <!-- Deck -->
    <string name="deck_loading">Loading your gallery…</string>
    <string name="deck_empty_title">All caught up!</string>
    <string name="deck_empty_body">You\'ve gone through everything here.</string>
    <plurals name="deck_marked">
        <item quantity="one">%1$d marked · %2$s</item>
        <item quantity="other">%1$d marked · %2$s</item>
    </plurals>
    <string name="deck_review">Review</string>
    <plurals name="deck_remaining">
        <item quantity="one">%1$d item left</item>
        <item quantity="other">%1$d items left</item>
    </plurals>
    <string name="deck_partial_access">Sweepy can only see the photos you picked.</string>
    <string name="deck_partial_access_action">Allow all</string>
    <string name="deck_freed">%1$s moved to trash</string>

    <string name="action_undo">Undo</string>
    <string name="action_delete">Delete</string>
    <string name="action_keep">Keep</string>
    <string name="action_later">Later</string>
    <string name="action_favorite">Favorite</string>
    <string name="action_info">Details</string>

    <string name="label_delete">DELETE</string>
    <string name="label_keep">KEEP</string>
    <string name="label_later">LATER</string>
    <string name="label_favorite">FAVORITE</string>

    <!-- Info sheet -->
    <string name="info_name">Name</string>
    <string name="info_folder">Folder</string>
    <string name="info_date">Date</string>
    <string name="info_size">Size</string>
    <string name="info_resolution">Resolution</string>
    <string name="info_type">Type</string>
    <string name="info_duration">Duration</string>
    <string name="info_unknown">Unknown</string>

    <!-- Review bin -->
    <string name="review_title">Review bin</string>
    <string name="review_back">Back</string>
    <string name="review_empty">Nothing marked for deletion yet.\nSwipe left on photos you don\'t need.</string>
    <string name="review_unmark">Keep this one</string>
    <plurals name="review_commit">
        <item quantity="one">Move %1$d item to trash · %2$s</item>
        <item quantity="other">Move %1$d items to trash · %2$s</item>
    </plurals>
    <string name="review_hint">Tap a photo to keep it. Items go to the system trash, where you can restore them for about 30 days.</string>
</resources>
